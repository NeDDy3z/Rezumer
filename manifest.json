{
  "manifest_version": 3,
  "name": "Rezumer",
  "version": "1.0.0",
  "description": "Automatically saves where you stopped watching and resumes from there.",
  "homepage_url": "https://github.com/NeDDy3z/Rezumer",
  "icons": {
    "48": "icons/play.svg",
    "96": "icons/play.svg"
  },
  "permissions": [
    "storage",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "sites.js",
      "background.js"
    ]
  },
  "action": {
    "default_title": "Rezumer",
    "default_popup": "popup.html",
    "default_icon": "icons/play.svg",
    "theme_icons": [
      {
        "light": "icons/play-white.svg",
        "dark": "icons/play-black.svg",
        "size": 16
      },
      {
        "light": "icons/play-white.svg",
        "dark": "icons/play-black.svg",
        "size": 32
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "sites.js",
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "rezumer@neddy3z",
      "strict_min_version": "149.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
